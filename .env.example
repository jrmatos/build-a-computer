# Copy to .env (git-ignored). Compose reads it automatically.

# Dev server (service `web`). Set to true if hot reload misses file changes
# (some Docker Desktop / VM file shares do not forward inotify events).
CHOKIDAR_USEPOLLING=false

# Production preview (service `web-prod`, profile `prod`).
WEB_PROD_PORT=8080

# Postgres (service `db`, profile `api`, used from M6).
POSTGRES_USER=groundup
POSTGRES_PASSWORD=groundup-dev-only
POSTGRES_DB=groundup
POSTGRES_PORT=5432
