{
  "name": "ground-up",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ground-up/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run //#lint:eslint",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "check": "turbo run //#lint:eslint typecheck test --continue",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:dev": "docker compose up web",
    "docker:prod": "docker compose --profile prod up --build web-prod",
    "docker:down": "docker compose --profile prod down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
